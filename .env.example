# Copy to .env before running:  cp .env.example .env
# Every service in docker-compose.yml loads this file.

# Password used to encrypt the node wallet at rest (~/.ledger/keys.enc). Required.
LEDGER_WALLET_PASSWORD=change_me

# Consensus engine: POW (proof-of-work) or POS (VRF + reputation-weighted stake)
CONSENSUS_MODE=POW

# Working directory for node state inside the container (mounted volume)
NODE_WORKDIR=/data

# Autonomous mining. When false, blocks are sealed manually with the /mine command.
AUTO_MINE=false

# Target interval between blocks when AUTO_MINE=true (seconds)
BLOCK_TIME_SECS=10
